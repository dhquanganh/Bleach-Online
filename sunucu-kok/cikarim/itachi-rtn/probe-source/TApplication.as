         }
         for each(var old:String in previous)
         {
            pins[old] = Math.max(0,int(pins[old]) - 1);
            if(pins[old] == 0)
            {
               delete pins[old];
            }
         }
         for each(var key:String in current)
         {
            pins[key] = int(pins[key]) + 1;
         }
         var queue:Array = FItachiFxLoading["_queue"] as Array;
         if(queue != null)
         {
            var i:int = queue.length - 1;
            while(i >= 0)
