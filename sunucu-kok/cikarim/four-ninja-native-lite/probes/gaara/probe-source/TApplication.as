      public function PlayGaaraVfxAsset(name:String,host:DisplayObjectContainer,point:Point,width:Number,height:Number,delay:int=0,mirrored:Boolean=false,follow:Boolean=false,behind:Boolean=false,angle:Number=0) : void {
