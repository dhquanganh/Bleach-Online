      public function UpdateGaaraVfx() : void
      {
         if(FId != 11120991 || FSkillId < 13121501 || FSkillId > 13121504 || FIndex != TYPE_ACTIVE_ATTACK && FIndex != TYPE_ACTIVE_SKILL || FGaaraVfxStarted)
         {
            return;
         }
         for each(var old:Sprite in FGaaraActiveVfx)
         {
            if(old.parent != null)
            {
               old.parent.removeChild(old);
            }
         }
         FGaaraActiveVfx = [];
         FGaaraVfxStarted = true;
         ShowGaaraVfx(FSkillId);
      }
      public function ShowGaaraVfx(skill:int) : void
      {
         var host:DisplayObjectContainer = FBattleStage;
         if(host == null || host.stage == null)
         {
            return;
         }
         var offset:Point = GaaraStrikeOffset();
         var origin:Point = host.globalToLocal(localToGlobal(new Point(offset.x + 70,offset.y)));
         var zero:Point = host.globalToLocal(localToGlobal(new Point()));
         var one:Point = host.globalToLocal(localToGlobal(new Point(1,0)));
         var unit:Number = Point.distance(zero,one);
         var data:Object = GaaraVfxManifest();
         var name:String = String(data.moves[skill]);
         var effects:Array = data.actions[name] as Array;
         if(skill == 13121501)
         {
            GaaraBackdrop(host);
         }
         if(effects != null)
         {
            for each(var effect:String in effects)
            {
               PlayGaaraEffect(effect,host,origin,skill == 13121501 ? 1600 : 1050,unit,0);
            }
         }
         if(skill == 13121502 && FTargets != null && FResults != null)
         {
            var i:int = 0;
            while(i < FTargets.length && i < FResults.length)
            {
               if(FTargets[i] != null && FResults[i].CMD == 8)
               {
                  var at:Point = host.globalToLocal(FTargets[i].localToGlobal(new Point()));
                  PlayGaaraEffect("GAR_shazhidun",host,at,300,unit,0);
               }
               i++;
            }
         }
      }
      public function FitGaaraPose() : void
      {
         if(FId != 11120991 || stage == null || FBitmap.bitmapData == null)
         {
            return;
         }
         var r:Rectangle = FBitmap.getBounds(stage);
         var dx:Number = 0;
         var dy:Number = 0;
         if(r.width < stage.stageWidth - 24)
         {
            if(r.left < 12)
            {
               dx = 12 - r.left;
            }
            else if(r.right > stage.stageWidth - 12)
            {
               dx = stage.stageWidth - 12 - r.right;
            }
         }
         if(r.height < stage.stageHeight - 24)
         {
            if(r.top < 12)
            {
               dy = 12 - r.top;
            }
            else if(r.bottom > stage.stageHeight - 12)
            {
               dy = stage.stageHeight - 12 - r.bottom;
            }
         }
         if(dx || dy)
         {
            var zero:Point = globalToLocal(stage.localToGlobal(new Point()));
            var shift:Point = globalToLocal(stage.localToGlobal(new Point(dx,dy)));
            FBitmap.x += shift.x - zero.x;
            FBitmap.y += shift.y - zero.y;
         }
      }
      public function GaaraBackdrop(host:DisplayObjectContainer) : void
      {
         var tl:Point;
         var br:Point;
         var caster:ProbeRole;
         var serial:uint;
         var skill:uint;
         var cleanup:Function;
         var dim:Sprite = new Sprite();
         dim.name = "gaaraSkillVfx";
         dim.mouseEnabled = false;
         tl = host.globalToLocal(stage.localToGlobal(new Point()));
         br = host.globalToLocal(stage.localToGlobal(new Point(stage.stageWidth,stage.stageHeight)));
         dim.graphics.beginFill(329241,0.55);
         dim.graphics.drawRect(tl.x,tl.y,br.x - tl.x,br.y - tl.y);
         dim.graphics.endFill();
         host.addChildAt(dim,0);
         FGaaraActiveVfx.push(dim);
         caster = this;
         serial = FCombatVfxSerial;
         skill = uint(FSkillId);
         cleanup = function(e:Event):void
         {
            if(caster.stage == null || caster.FCombatVfxSerial != serial || caster.FSkillId != skill)
            {
               dim.removeEventListener(Event.ENTER_FRAME,cleanup);
               if(dim.parent != null)
               {
                  dim.parent.removeChild(dim);
               }
            }
         };
         dim.addEventListener(Event.ENTER_FRAME,cleanup);
      }
      public function PlayGaaraEffect(effect:String, host:DisplayObjectContainer, at:Point, limit:Number, unit:Number, delay:int) : void
      {
         var data:Object = GaaraVfxManifest();
         var layers:Array = data.effects[effect] as Array;
         if(layers == null)
         {
            return;
         }
         var left:Number = 0;
         var right:Number = 0;
         var top:Number = 0;
         var bottom:Number = 0;
         for each(var key:String in layers)
         {
            var c:Object = data.clips[key];
            var w:Number = c.worldWidth != null ? Number(c.worldWidth) : c.width / c.renderScale;
            var h:Number = c.worldHeight != null ? Number(c.worldHeight) : c.height / c.renderScale;
            left = Math.min(left,-Number(c.pivot[0]) * w);
            right = Math.max(right,(1 - Number(c.pivot[0])) * w);
            top = Math.min(top,-Number(c.pivot[1]) * h);
            bottom = Math.max(bottom,(1 - Number(c.pivot[1])) * h);
         }
         var fit:Number = Math.min(unit,limit * unit / Math.max(1,right - left,bottom - top));
         if(effect == "Yzwoailuo_aoyi")
         {
            fit *= 2;
         }
         for each(key in layers)
         {
            c = data.clips[key];
            PlayGaaraVfxAsset(key,host,at,(c.worldWidth != null ? Number(c.worldWidth) : c.width / c.renderScale) * fit,(c.worldHeight != null ? Number(c.worldHeight) : c.height / c.renderScale) * fit,delay,scaleX < 0,effect != "GAR_shazhidun",false);
         }
      }
      public function GaaraStrikeOffset() : Point
      {
         if(FId != 11120991 || FIndex != TYPE_ACTIVE_ATTACK && FIndex != TYPE_ACTIVE_SKILL || FSkillId == 13121502 || FTargets == null || FResults == null)
         {
            return new Point();
         }
         var data:Object = GaaraVfxManifest();
         var clip:Object = data.clips;
         var timing:Object = data.poseTiming[String(FSkillId)];
         if(timing == null)
         {
            return new Point();
         }
         var distance:Number = FSkillId == 13121503 ? 460 : 400;
         var t:Number = Math.min(1,Math.max(0,FFrameIndex / 8));
         var back:Number = Math.min(1,Math.max(0,(Number(timing.end) - FFrameIndex) / 12));
         var weight:Number = t * t * (3 - 2 * t) * back * back * (3 - 2 * back);
         var i:int = 0;
         while(i < FTargets.length && i < FResults.length)
         {
            var enemy:ProbeRole = FTargets[i];
            if(!(enemy == null || enemy == this || enemy.Camp == Camp || FResults[i].CMD != TTargetInfo.CMD_ATTACK))
            {
               var pt:Point = globalToLocal(enemy.localToGlobal(new Point()));
               return new Point(Math.max(0,pt.x - distance) * weight,pt.y * weight);
            }
            i++;
         }
         return new Point();
      }
      public function GaaraStrikePose(frame:Object) : void
      {
         if(FId != 11120991 || frame == null || FIndex != TYPE_ACTIVE_ATTACK && FIndex != TYPE_ACTIVE_SKILL)
         {
            return;
         }
         var offset:Point = GaaraStrikeOffset();
         FBitmap.x = -frame.Pivot.X + offset.x;
         FBitmap.y = -frame.Pivot.Y + offset.y;
      }
