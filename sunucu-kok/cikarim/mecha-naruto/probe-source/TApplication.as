         if(queue==null || queue.length==0 || int(FMechaFxLoading["_inflight"])>=6)return;
         queue.sortOn("deadline",Array.NUMERIC);
         var job:Object=queue.shift();
         var name:String=String(job.name);
         var meta:Object=job.meta;
         FMechaFxLoading["_inflight"]=int(FMechaFxLoading["_inflight"])+1;
         var loader:flash.net.URLLoader=new flash.net.URLLoader();
         loader.dataFormat=flash.net.URLLoaderDataFormat.BINARY;
         var complete:Function;
         var failed:Function;
         var release:Function=function():void
         {
            loader.removeEventListener(Event.COMPLETE,complete);
            loader.removeEventListener(IOErrorEvent.IO_ERROR,failed);
            loader.removeEventListener(SecurityErrorEvent.SECURITY_ERROR,failed);
            delete FMechaFxLoading[name];
            FMechaFxLoading["_inflight"]=Math.max(0,int(FMechaFxLoading["_inflight"])-1);
            loader.data=null;
            PumpMechaVfxQueue();
         };
         failed=function(event:Event):void{release();};
         complete=function(event:Event):void
         {
            var data:ByteArray=loader.data as ByteArray;
            try
            {
            if(data!=null)
            {
               data.uncompress();
               var w:int=data.readUnsignedInt();var h:int=data.readUnsignedInt();
               var source:BitmapData=new BitmapData(w,h,true,0);
               source.setPixels(new Rectangle(0,0,w,h),data);
               data.clear();
               var frames:Array=[source];
               FMechaFxCache[name] = frames;if(ExternalInterface.available)ExternalInterface.call("vfxProbe","ATLAS "+name);
               TrimMechaVfxCache(name);
            }
            }
            catch(error:Error)
            {
               if(data!=null)data.clear();
               if(source!=null && FMechaFxCache[name]==null)source.dispose();
            }
            release();
         };
         loader.addEventListener(Event.COMPLETE,complete);
         loader.addEventListener(IOErrorEvent.IO_ERROR,failed);
         loader.addEventListener(SecurityErrorEvent.SECURITY_ERROR,failed);
         loader.load(new URLRequest(String(meta.url).replace(".png",".argb")));
         PumpMechaVfxQueue();
      }
}
}
